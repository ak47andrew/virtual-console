; WARNING! It's hella slow: 10-15 minutes of runtime. Just for demonstration purposes
; Setup. G1 is a pixel, GP2 is an address pointing to VRAM
mov 0 !G1
mov &0 ?GP2

loop:
; Set the pixel
mov !G1 [?GP2]
; Display progress
vsync

; Incrementing color pixel
add !G1 1
; Wrap to 32 (mod is in X reg)
div !A 32
; Storing it back
mov !X !G1

; Moving to the next pixel in VRAM
add ?GP2 &1
mov ?LL1 ?GP2

; If we're at the end of VRAM - stop
sub &61440 ?GP2
jnz !Z $exit

; Otherwise - repeat
jmp $loop

exit:
hlt
