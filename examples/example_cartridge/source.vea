; GP1 - x, G2 - y, G3 - input
mov 0 !G1
mov 0 !G2

frame:
; Draw
bg 0
img 0 !G1 !G2
vsync


; Handle input. $63438 - INPUT_HELD
mov $63439 !G3

check_up:
and !G3 0b10000000
jz !A $check_down
sub !G2 8
mov !A !G2

check_down:
and !G3 0b01000000
jz !A $check_right
add !G2 8
mov !A !G2

check_right:
and !G3 0b00010000
jz !A $check_left
add !G1 8
mov !A !G1

check_left:
and !G3 0b00100000
jz !A $frame
sub !G1 8
mov !A !G1

jmp $frame