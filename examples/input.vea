; GP1 - pos, G3 - input, G4 - color of the guy, GP2 - prev pos
mov &400 ?GP1
mov 9 !G4

frame:
; Draw the guy
; Clear last place, draw on the new one and save the pos
mov 1 [?GP2]
mov !G4 [?GP1]
vsync
mov ?GP1 ?GP2

; Handle input. $63438 - INPUT_HELD
mov $63438 !G3

check_up:
and !G3 0b10000000
jne !A $check_down
sub ?GP1 &256
mov ?LL1 ?GP1

check_down:
and !G3 0b01000000
jne !A $check_right
add ?GP1 &256
mov ?LL1 ?GP1

check_right:
and !G3 0b00010000
jne !A $check_left
add ?GP1 &1
mov ?LL1 ?GP1

check_left:
and !G3 0b00100000
jne !A $frame
sub ?GP1 &1
mov ?LL1 ?GP1

jmp $frame