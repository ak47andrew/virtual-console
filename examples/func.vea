; Variation of additive.vea split up into functions
jmp $setup

update_pixel:
; Randomizing next pixel
mul !G1 137
add !A 187
div !A 32
mov !X !G1 ; Storing it back
ret

render:
mov !G1 [?GP2] ; Set the pixel
vsync ; Display progress
ret

update_addr:
; Moving to the next pixel in VRAM
add ?GP2 &1
mov ?LL1 ?GP2
ret

setup:
mov 2 !G1  ; Current color
mov &0 ?GP2  ; Current position

loop:
call $render
call $update_pixel
call $update_addr

; If we're at the end of VRAM - stop
sub &61440 ?GP2
jnz !Z $exit

; Otherwise - repeat
jmp $loop

exit:
hlt
